{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "cinerama",
    "version": "0.1.0",
    "identifier": "com.hugoattal.cinerama",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1430",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Cinerama",
                "width": 260,
                "height": 140,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Utility",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
